{
  "name": "McGraw-Hill SmartBook Autopilot",
  "description": "Automatically answer McGraw-Hill SmartBook questions, remember revealed answers, and optionally use your own OpenAI API key.",
  "version": "1.0.7",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Open SmartBook Autopilot"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://learning.mheducation.com/*"
      ],
      "js": [
        "llm-client.js",
        "autopilot.js",
        "highlight.js"
      ]
    }
  ],
  "options_page": "settings.html",
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "short_name": "SmartBook Autopilot"
}
